      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0sqtrj21i44eyf13ratx40uzu540].[cnt:Do you know where your coffee comes from?:qk]&quot;' value='Knows Coffee Origin' />
          <alias key='&quot;[federated.0sqtrj21i44eyf13ratx40uzu540].[cnt:F1:qk]&quot;' value='Number of Survey' />
          <alias key='&quot;[federated.0sqtrj21i44eyf13ratx40uzu540].[cnt:State:qk]&quot;' value='Number of Shipments' />
          <alias key='&quot;[federated.0sqtrj21i44eyf13ratx40uzu540].[cnt:Why do you drink coffee? (It makes me go to the bathroom):qk]&quot;' value='It makes me go to the bathroom' />
          <alias key='&quot;[federated.0sqtrj21i44eyf13ratx40uzu540].[sum:Why do you drink coffee? (I need the caffeine):qk]&quot;' value='I need the caffeine' />
          <alias key='&quot;[federated.0sqtrj21i44eyf13ratx40uzu540].[sum:Why do you drink coffee? (I need the ritual):qk]&quot;' value='I need the ritual' />
          <alias key='&quot;[federated.0sqtrj21i44eyf13ratx40uzu540].[sum:Why do you drink coffee? (It tastes good):qk]&quot;' value='It tastes good' />
          <alias key='&quot;[federated.0sqtrj21i44eyf13ratx40uzu540].[usr:Calculation_1427641127219798022:qk]&quot;' value='Avg Monthly Spend' />
        </aliases>
      </column>
      <column caption='AVG Shipping Cost' datatype='real' name='[AVG_Shipping_Cost]' role='measure' type='quantitative' />
      <column caption='at Least 10 Survey Submissions' datatype='string' name='[Calculation_1427641127238160393]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF COUNTD([F1]) &gt;= 10 THEN &quot;Valid&quot; ELSE &quot;Exclude&quot; END' />
      </column>
      <column caption='Subs&amp;Unsubs Sales Profit' datatype='real' name='[Calculation_844706450653876227]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales (in USD)])/COUNT([coffee_subscription])' />
      </column>
      <column caption='Coffee Price' datatype='real' name='[Calculation_844706450658959365]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales (in USD)])-(COUNT([State])*AVG([AVG_Shipping_Cost])))/COUNT([State])' />
      </column>
      <column caption='Max Count Filter' datatype='boolean' name='[Calculation_844706450691088390]' role='measure' type='nominal'>
        <calculation class='tableau' formula='COUNT([F1]) = WINDOW_MAX(COUNT([F1]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='KPI is Coffee Worth the Price' datatype='string' name='[Calculation_844706450704408585]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;    COUNT(IF [Do you feel like you’re getting good value for your money when you buy coffee at a cafe?] = &quot;Yes&quot; THEN 1 END) &gt; &#13;&#10;    COUNT(IF [Do you feel like you’re getting good value for your money when you buy coffee at a cafe?] = &quot;No&quot; THEN 1 END) &#13;&#10;THEN &#13;&#10;    &quot;Yes&quot; &#13;&#10;ELSE &#13;&#10;    &quot;No&quot; &#13;&#10;END' />
      </column>
      <column datatype='string' name='[Do you feel like you’re getting good value for your money with regards to your coffee equipment?]' role='dimension' type='nominal' />
      <column datatype='string' name='[Do you know where your coffee comes from?]' role='dimension' type='nominal' />
      <column datatype='string' name='[Ethnicity/Race]' role='dimension' type='nominal' />
      <column datatype='string' name='[F1]' role='dimension' type='nominal' />
      <column caption='In total, much money do you typically spend on coffee in a month?1' datatype='string' name='[In total, much money do you typically spend on coffee in a month?]' role='dimension' type='nominal' />
      <column caption='KPI - Do you like taste of coffee?' datatype='string' name='[KPI is Coffee Worth the Price (copy)_844706450707742730]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF &#13;&#10;    COUNT(IF [Do you like the taste of coffee?] = &quot;Yes&quot; THEN 1 END) &gt; &#13;&#10;    COUNT(IF [Do you like the taste of coffee?] = &quot;No&quot; THEN 1 END) &#13;&#10;THEN &#13;&#10;    &quot;Yes&quot; &#13;&#10;ELSE &#13;&#10;    &quot;No&quot; &#13;&#10;END' />
      </column>
