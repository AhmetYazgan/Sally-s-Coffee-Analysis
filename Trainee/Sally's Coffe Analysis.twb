          <datasource-dependencies datasource='federated.0sqtrj21i44eyf13ratx40uzu540'>
            <column caption='at Least 10 Survey Submissions' datatype='string' name='[Calculation_1427641127238160393]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF COUNTD([F1]) &gt;= 10 THEN &quot;Valid&quot; ELSE &quot;Exclude&quot; END' />
            </column>
            <column caption='Max Count Filter' datatype='boolean' name='[Calculation_844706450691088390]' role='measure' type='nominal'>
              <calculation class='tableau' formula='COUNT([F1]) = WINDOW_MAX(COUNT([F1]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column datatype='string' name='[F1]' role='dimension' type='nominal' />
            <column datatype='real' name='[Sales (in USD)]' role='measure' type='quantitative' />
            <column caption='What is the most you&apos;d ever be willing to pay for a cup of coffee?1' datatype='string' name='[What is the most you&apos;d ever be willing to pay for a cup of coffee?]' role='dimension' type='nominal' />
            <column aggregation='Sum' caption='Zip Codes' datatype='integer' default-format='*00000' name='[ZipCodes]' role='dimension' semantic-role='[ZipCode].[Name]' type='ordinal' />
            <column-instance column='[F1]' derivation='Count' name='[cnt:F1:qk]' pivot='key' type='quantitative' />
            <column-instance column='[What is the most you&apos;d ever be willing to pay for a cup of coffee?]' derivation='None' name='[none:What is the most you&apos;d ever be willing to pay for a cup of coffee?:nk]' pivot='key' type='nominal' />
            <column-instance column='[ZipCodes]' derivation='None' name='[none:ZipCodes:ok]' pivot='key' type='ordinal' />
